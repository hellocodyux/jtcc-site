---
/**
 * Contact — heading, direct email, and a compact form in one block.
 *
 * Fields are paired two-up so the whole thing fits in roughly half
 * the vertical space of a stacked layout. Inputs use a single bottom
 * rule rather than full boxes.
 */
import content from '~/content/content.json';
import { form as formConfig } from '~/config';
const { form, business } = content;
const f = form.fields;

const field =
  'mt-1.5 w-full border-0 border-b border-sand bg-transparent px-0 py-2 text-base ' +
  'outline-none transition-colors placeholder:text-coffee/35 focus:border-rosewood ' +
  'aria-[invalid=true]:border-rosewood';
const labelCls = 'block text-xs uppercase tracking-[0.12em] text-coffee/60';
---
<section id="contact" class="band-accent">
  <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
    <div class="grid gap-8 md:grid-cols-12 md:gap-10">
      <!-- Left: the ask -->
      <div class="reveal md:col-span-4">
        <h2 class="text-rosewood text-lg md:text-xl">{form.heading}</h2>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-coffee/75">{form.intro}</p>

        <p class="mt-6 text-xs uppercase tracking-[0.12em] text-coffee/60">
          {form.emailLabel}
        </p>
        <a
          href={`mailto:${business.email}`}
          class="link-warm mt-1 inline-block text-base !text-ember-deep"
        >
          {business.email}
        </a>

        <p class="mt-6 text-sm leading-relaxed text-muted">{form.note}</p>
      </div>

      <!-- Right: the form -->
      <form
        id="jtcc-contact"
        class="reveal md:col-span-8"
        data-endpoint={formConfig.endpoint}
        data-fallback={formConfig.fallbackEmail}
        novalidate
      >
        <div class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div>
            <label for="cf-name" class={labelCls}>
              {f.name} <span aria-hidden="true" class="text-ember-deep">*</span>
            </label>
            <input id="cf-name" name="name" type="text" required autocomplete="name" class={field} />
          </div>

          <div>
            <label for="cf-email" class={labelCls}>
              {f.email} <span aria-hidden="true" class="text-ember-deep">*</span>
            </label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" class={field} />
          </div>

          <div>
            <label for="cf-phone" class={labelCls}>
              {f.phone} <span aria-hidden="true" class="text-ember-deep">*</span>
            </label>
            <input id="cf-phone" name="phone" type="tel" required autocomplete="tel" class={field} />
          </div>

          <div>
            <label for="cf-guests" class={labelCls}>{f.guests}</label>
            <input
              id="cf-guests" name="guests" type="number" min="1" inputmode="numeric"
              placeholder="e.g. 20" class={field}
            />
          </div>

          <div class="sm:col-span-2">
            <label for="cf-date" class={labelCls}>{f.eventDate}</label>
            <input
              id="cf-date" name="eventDate" type="text"
              placeholder="June 14, 40th birthday" class={field}
            />
          </div>

          <div class="sm:col-span-2">
            <label for="cf-message" class={labelCls}>{f.message}</label>
            <textarea
              id="cf-message" name="message" rows="3"
              placeholder="Anything that would help us plan"
              class={`${field} resize-y`}
            ></textarea>
          </div>
        </div>

        <!--
          Spam honeypot. Real visitors never see this, so anything that
          fills it in is a bot — Formspree discards those silently.
        -->
        <input
          type="text" name="_gotcha" tabindex="-1" autocomplete="off"
          aria-hidden="true" class="hidden"
        />

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <p
            id="cf-status"
            role="status"
            aria-live="polite"
            class="text-sm text-coffee/70"
          ></p>
          <button
            type="submit"
            class="btn-solid disabled:opacity-50"
          >
            {form.submit}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ successMsg: form.success, errorMsg: form.error }}>
  const formEl = document.getElementById('jtcc-contact');
  const status = document.getElementById('cf-status');

  if (formEl instanceof HTMLFormElement && status) {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();

      const required = ['name', 'email', 'phone'];
      let firstBad = null;
      for (const key of required) {
        const el = formEl.elements.namedItem(key);
        if (!(el instanceof HTMLInputElement)) continue;
        const bad = !el.checkValidity();
        el.setAttribute('aria-invalid', bad ? 'true' : 'false');
        if (bad && !firstBad) firstBad = el;
      }
      if (firstBad) {
        status.textContent = 'Please fill in the required fields.';
        firstBad.focus();
        return;
      }

      const data = Object.fromEntries(new FormData(formEl).entries());
      const endpoint = formEl.dataset.endpoint;
      const button = formEl.querySelector('button[type="submit"]');
      if (button) button.disabled = true;

      try {
        if (endpoint) {
          // Subject line in the inbox, so inquiries are scannable.
          data._subject = `Event inquiry — ${data.name || 'website'}`;

          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) {
            // Formspree replies with { errors: [{ message }] } on a bad request.
            const detail = await res.json().catch(() => null);
            const first = detail && detail.errors && detail.errors[0];
            throw new Error(first ? first.message : `HTTP ${res.status}`);
          }
        } else {
          const subject = `Event inquiry from ${data.name || ''}`;
          const body = [
            `Name: ${data.name || ''}`,
            `Email: ${data.email || ''}`,
            `Phone: ${data.phone || ''}`,
            `Event: ${data.eventDate || ''}`,
            `Guests: ${data.guests || ''}`,
            '',
            data.message || '',
          ].join('\n');
          window.location.href =
            `mailto:${formEl.dataset.fallback}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        }
        status.textContent = successMsg;
        formEl.reset();
      } catch (err) {
        console.warn('Contact form:', err);
        status.textContent = errorMsg;
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
