---
import content from '~/content/content.json';
const { testimonials } = content;
---
<section id="testimonials" class="band-deep">
  <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
    <div class="grid items-start gap-x-14 gap-y-8 md:grid-cols-12">

      <div class="reveal min-w-0 md:col-span-12">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="text-rosewood text-lg md:text-xl">{testimonials.heading}</h2>
            <p class="mt-2 text-sm leading-relaxed text-coffee/70">{testimonials.intro}</p>
          </div>
          <div class="flex gap-2">
            <button type="button" class="rail-btn" data-rail-prev="quotes" aria-label="Previous reviews">
              <span aria-hidden="true">&larr;</span>
            </button>
            <button type="button" class="rail-btn" data-rail-next="quotes" aria-label="Next reviews">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>

        <ul class="rail list-none" data-rail="quotes" aria-label="Client reviews">
          {testimonials.quotes.map((t) => (
            <li class="w-[17rem] md:w-[19rem]">
              <figure class="flex h-full flex-col border-t border-sand pt-5">
                <blockquote class="font-display text-base leading-snug md:text-lg">
                  &ldquo;{t.quote}&rdquo;
                </blockquote>
                <figcaption class="mt-4 text-xs">
                  <span class="block text-coffee/70">{t.attribution}</span>
                  <span class="block text-muted">{t.context}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>

        {testimonials.ctaUrl && (
          <a
            href={testimonials.ctaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-warm mt-4 inline-flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.16em]"
          >
            {testimonials.cta}
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>

    </div>
  </div>
</section>
