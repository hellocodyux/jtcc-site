---
import content from '~/content/content.json';
import Ornament from './Ornament.astro';
const { testimonials } = content;
---
<section id="testimonials" class="band-deep">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <Ornament motif="bloom" class="mb-4 h-7 w-7 text-rosewood/60" />
        <h2 class="text-3xl md:text-4xl">{testimonials.heading}</h2>
        <p class="mt-3 text-base leading-relaxed text-coffee/70">{testimonials.intro}</p>
      </div>
      <div class="flex gap-2">
        <button type="button" class="rail-btn" data-rail-prev="quotes" aria-label="Previous reviews">
          <span aria-hidden="true">&larr;</span>
        </button>
        <button type="button" class="rail-btn" data-rail-next="quotes" aria-label="Next reviews">
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>

    <ul
      class="rail reveal list-none"
      data-rail="quotes"
      aria-label="Client reviews"
    >
      {testimonials.quotes.map((t) => (
        <li class="w-[17rem] md:w-[19rem]">
          <figure class="flex h-full flex-col border-t border-sand pt-5">
            <blockquote class="font-display text-base leading-snug md:text-lg">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-4 text-xs">
              <span class="block text-coffee/70">{t.attribution}</span>
              <span class="block text-muted">{t.context}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    {testimonials.ctaUrl && (
      <a
        href={testimonials.ctaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal mt-10 inline-flex items-center gap-3 border-b border-rosewood pb-1 text-sm uppercase tracking-[0.16em] text-rosewood transition-opacity hover:opacity-60"
      >
        {testimonials.cta}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>
</section>
