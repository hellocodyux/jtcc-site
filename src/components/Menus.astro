---
import content from '~/content/content.json';
import { formatTrayPrice } from '~/lib/commerce/catalog';
import SectionHead from './SectionHead.astro';
import Figure from './Figure.astro';

const { menus } = content;
const key = menus.dietaryKey as Record<string, string>;
const { purveyors } = menus;
---
<section id="menus" class="border-t border-clay/30 bg-bone">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-36">
    <SectionHead heading={menus.heading} intro={menus.intro} />

    <p class="reveal -mt-10 mb-16 text-xs uppercase tracking-[0.22em] text-slate">
      {menus.servingNote}
    </p>

    {menus.sections.map((section) => (
      <div class="mb-20 last:mb-0">
        <h3
          class="reveal mb-2 font-body text-xs uppercase tracking-[0.28em] text-ember"
        >
          {section.name}
        </h3>

        <div class="longtable">
          {section.items.map((item) => (
            <article class="longtable-row reveal">
              <div class="flex flex-col gap-1">
                <div class="flex items-baseline gap-3">
                  <h4 class="font-display text-2xl md:text-3xl">{item.name}</h4>
                  <span class="tabular text-lg text-ink/60">
                    {formatTrayPrice(item.price)}
                  </span>
                </div>

                <p class="max-w-sm text-base leading-relaxed text-ink/75">
                  {item.description}
                </p>

                {item.note && (
                  <p class="mt-1 max-w-sm text-sm leading-relaxed text-ink/55">
                    {item.note}
                  </p>
                )}

                {item.dietary.length > 0 && (
                  <p class="mt-1 text-xs uppercase tracking-[0.14em] text-slate">
                    {item.dietary.map((d) => key[d]).join(' · ')}
                  </p>
                )}

                {item.image && (
                  <Figure
                    image={item.image}
                    class="mt-4 aspect-[4/3] w-full max-w-sm object-cover"
                    sizes="(min-width: 900px) 24rem, 100vw"
                  />
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <p class="reveal mt-16 max-w-md text-sm leading-relaxed text-ink/60">
      {menus.footnote}
    </p>

    <div class="reveal mt-20 border-t border-clay/40 pt-8 md:flex md:gap-16">
      <div class="md:w-1/3">
        <h3 class="font-body text-xs uppercase tracking-[0.28em] text-ember">
          {purveyors.heading}
        </h3>
        <p class="mt-4 max-w-sm text-base leading-relaxed text-ink/75">
          {purveyors.intro}
        </p>
      </div>
      <ul class="mt-8 space-y-2 md:mt-0">
        {purveyors.list.map((name) => (
          <li class="font-display text-xl md:text-2xl">{name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
