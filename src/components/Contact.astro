---
import content from '~/content/content.json';
const { contact, footer, business } = content;
const year = new Date().getFullYear();
---
<section id="contact" class="bg-ember text-bone">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="reveal max-w-2xl">
      <h2 class="text-4xl md:text-5xl">{contact.heading}</h2>
      <p class="mt-5 text-lg leading-relaxed text-bone/85">{contact.body}</p>

      <a
        href={contact.cta.href}
        class="mt-10 inline-block border-b border-bone/60 pb-1 font-display text-2xl transition-opacity hover:opacity-70 md:text-3xl"
      >
        {contact.cta.label}
      </a>

      {business.phone && (
        <p class="mt-4">
          <a
            href={business.phoneHref}
            class="border-b border-bone/40 pb-0.5 text-lg transition-opacity hover:opacity-70"
          >
            {business.phone}
          </a>
        </p>
      )}

      <p class="mt-8 text-sm text-bone/70">{contact.note}</p>
    </div>
  </div>

  <footer class="border-t border-bone/20">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-bone/70 md:flex-row md:items-center md:justify-between"
    >
      <p class="font-display text-base text-bone">{footer.tagline}</p>
      <p>{footer.location}</p>
      <div class="flex gap-5">
        <a href={business.instagramUrl} class="hover:opacity-70" rel="me noopener">
          Instagram
        </a>
        <span>&copy; {year} {business.name}</span>
      </div>
    </div>
  </footer>
</section>
