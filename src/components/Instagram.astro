---
/**
 * Live Instagram feed via Behold.so, shown as a horizontal carousel.
 * Set instagram.feedId in content.json to switch it on.
 */
import content from '~/content/content.json';
const { instagram, business } = content;
const feedId = instagram.feedId?.trim() ?? '';
const enabled = feedId.length > 0;
---
<section id="instagram" class="band">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="reveal mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="text-3xl md:text-4xl">
          Follow us on{' '}
          <a
            href={business.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-umber underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70"
          >
            Instagram
          </a>
        </h2>
        <p class="mt-3 text-base text-choc/70">{instagram.intro}</p>
      </div>

      {enabled && (
        <div class="flex gap-2">
          <button type="button" class="rail-btn" data-rail-prev="ig" aria-label="Previous photos">
            <span aria-hidden="true">&larr;</span>
          </button>
          <button type="button" class="rail-btn" data-rail-next="ig" aria-label="Next photos">
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      )}
    </div>

    {enabled && (
      <ul
        id="ig-feed"
        class="rail reveal list-none"
        data-rail="ig"
        data-feed-id={feedId}
        data-limit={instagram.limit}
        aria-label="Recent Instagram photos"
      >
        {Array.from({ length: instagram.limit }).map(() => (
          <li class="h-40 w-40 animate-pulse bg-moss-100 md:h-44 md:w-44"></li>
        ))}
      </ul>
    )}
  </div>
</section>

<script>
  const feed = document.getElementById('ig-feed');

  if (feed instanceof HTMLElement) {
    const feedId = feed.dataset.feedId;
    const limit = Number(feed.dataset.limit ?? 6);

    const readPosts = (data: unknown): any[] => {
      if (Array.isArray(data)) return data;
      if (data && typeof data === 'object' && 'posts' in data) {
        const p = (data as { posts: unknown }).posts;
        if (Array.isArray(p)) return p;
      }
      return [];
    };

    const imageOf = (post: any): string | null =>
      post?.sizes?.small?.mediaUrl ??
      post?.sizes?.medium?.mediaUrl ??
      post?.thumbnailUrl ??
      (post?.mediaType === 'VIDEO' ? null : post?.mediaUrl) ??
      null;

    const altOf = (post: any): string =>
      post?.altText || post?.prunedCaption || post?.caption ||
      'Instagram post from Joshua Tree Catering Co.';

    (async () => {
      try {
        const res = await fetch(`https://feeds.behold.so/${feedId}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const posts = readPosts(await res.json()).slice(0, limit);
        if (posts.length === 0) throw new Error('no posts');

        feed.innerHTML = '';
        for (const post of posts) {
          const src = imageOf(post);
          if (!src) continue;

          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = post.permalink ?? 'https://www.instagram.com/joshuatreecateringco/';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'warm group relative block h-40 w-40 overflow-hidden md:h-44 md:w-44';

          const img = document.createElement('img');
          img.src = src;
          img.alt = altOf(post).slice(0, 140);
          img.loading = 'lazy';
          img.decoding = 'async';
          img.width = 400;
          img.height = 400;
          img.className =
            'h-full w-full object-cover transition-transform duration-700 group-hover:scale-105';

          a.appendChild(img);
          li.appendChild(a);
          feed.appendChild(li);
        }
      } catch (err) {
        console.warn('Instagram feed unavailable:', err);
        feed.remove();
        document.querySelectorAll('[data-rail-prev="ig"], [data-rail-next="ig"]')
          .forEach((b) => b.remove());
      }
    })();
  }

  // Shared rail controls
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const key = rail.dataset.rail;
    const step = () => rail.clientWidth * 0.8;
    const prev = document.querySelector(`[data-rail-prev="${key}"]`);
    const next = document.querySelector(`[data-rail-next="${key}"]`);

    const sync = () => {
      if (prev instanceof HTMLButtonElement) prev.disabled = rail.scrollLeft <= 4;
      if (next instanceof HTMLButtonElement) {
        next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
      }
    };

    prev?.addEventListener('click', () => rail.scrollBy({ left: -step() }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step() }));
    rail.addEventListener('scroll', sync, { passive: true });
    setTimeout(sync, 300);
  });
</script>
