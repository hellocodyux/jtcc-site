---
/**
 * PageHeader — the inner-page version of the home hero: a block of
 * forest green with the page name in script and a line underneath.
 * A cream scallop edge finishes the bottom, the way the mission card
 * notches into the green on the home page.
 */
import Scallop from './Scallop.astro';
interface Props { heading: string; lede?: string; }
const { heading, lede } = Astro.props;
---
<header class="band-invert">
  <div class="mx-auto max-w-3xl px-6 pb-20 pt-32 text-center md:pb-24 md:pt-40">
    <h1 class="script text-chiffon text-[clamp(2.3rem,6vw,4rem)] leading-[1.15]">
      {heading}
    </h1>
    {lede && (
      <p class="mx-auto mt-6 max-w-lg text-[0.98rem] leading-relaxed text-chiffon/85">
        {lede}
      </p>
    )}
  </div>
</header>
<Scallop color="chiffon" />
