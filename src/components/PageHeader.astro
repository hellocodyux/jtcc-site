---
interface Props { heading: string; lede?: string; }
const { heading, lede } = Astro.props;
---
<header class="band-deep">
  <div class="mx-auto max-w-6xl px-6 pb-16 pt-36 md:pb-24 md:pt-44">
    <h1 class="max-w-3xl text-[clamp(2.5rem,7vw,4.5rem)]">{heading}</h1>
    {lede && (
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-choc/75">{lede}</p>
    )}
  </div>
</header>
