---
import content from '~/content/content.json';
const { footer, business } = content;
const year = new Date().getFullYear();
---
<footer class="band-invert">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-chiffon/70 md:flex-row md:items-center md:justify-between"
  >
    <p class="font-display text-base text-chiffon">{footer.tagline}</p>
    <p>{footer.location}</p>
    <div class="flex items-center gap-5">
      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-opacity hover:opacity-60"
      >
        Instagram
      </a>
      <span class="text-sand">&copy; {year} {business.name}</span>
    </div>
  </div>
</footer>
