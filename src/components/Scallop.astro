---
/**
 * Scallop — a scalloped edge between two sections, like the deckled
 * edge of a stamp. A strip in `color` that overlaps the section above
 * by its own height, so the section below appears to have a scalloped
 * top. Scallops are a fixed size, so they look the same on a phone
 * and a wide screen.
 *
 *   <Scallop color="chiffon" />
 */
interface Props {
  color?: 'chiffon' | 'chiffon-deep' | 'sky' | 'sky-deep' | 'rosewood' | 'coffee';
  class?: string;
  /** Scallop diameter in px */
  size?: number;
}
const { color = 'chiffon', class: className = '', size = 26 } = Astro.props;
const r = size / 2;
const h = Math.round(r * 1.1);
---
<div
  class={`relative z-10 w-full ${className}`}
  style={`
    height:${h}px;
    margin-top:-${h}px;
    background-image: radial-gradient(circle at 50% 100%, var(--color-${color}) 0 ${r - 0.6}px, transparent ${r + 0.4}px);
    background-size: ${size}px ${h}px;
    background-repeat: repeat-x;
    background-position: center bottom;
  `}
  aria-hidden="true"
></div>
