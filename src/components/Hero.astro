---
/**
 * Hero — full-bleed photo, scrimmed, wordmark overlaid.
 *
 * The wordmark is rendered as a CSS mask rather than a plain <img>,
 * so its shape comes from the PNG's transparency and its colour comes
 * from the palette. That means recolouring it is a token change, not
 * an image edit.
 */
import content from '~/content/content.json';
import Figure from './Figure.astro';
const { hero } = content;

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{png,svg,webp}',
  { eager: true }
);
const logoEntry = Object.entries(logoFiles).find(
  ([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === hero.logo?.key
);
const logoSrc = logoEntry?.[1].default;
const useLogo = hero.showLogo && logoSrc;

const swatch: Record<string, string> = {
  chiffon: 'var(--color-chiffon)',
  rosewood: 'var(--color-rosewood)',
  coffee: 'var(--color-coffee)',
  sky: 'var(--color-sky)',
};
const logoColor = swatch[hero.logo?.color ?? 'chiffon'] ?? swatch.chiffon;
const ratio = logoSrc ? logoSrc.height / logoSrc.width : 0.575;
---
<section id="top" class="warm scrim relative min-h-[92vh] overflow-hidden">
  <Figure
    image={hero.image}
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover"
    sizes="100vw"
  />

  <div class="relative z-10 mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-end px-6 pb-20 pt-32">
    {useLogo ? (
      <>
        <div
          class="mb-8 w-[min(80vw,720px)]"
          role="img"
          aria-label={hero.logo.alt}
          style={`
            aspect-ratio: ${logoSrc.width} / ${logoSrc.height};
            background-color: ${logoColor};
            -webkit-mask-image: url(${logoSrc.src});
            mask-image: url(${logoSrc.src});
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-size: contain;
            mask-size: contain;
            -webkit-mask-position: left center;
            mask-position: left center;
            filter: drop-shadow(0 2px 18px rgba(45, 18, 13, 0.5));
          `}
        ></div>

        {/* Present for search engines and screen readers. */}
        <h1 class="sr-only">{hero.headline} — {hero.logo.alt}</h1>

        <p class="max-w-lg text-xl leading-snug text-chiffon md:text-2xl">
          {hero.headline}
        </p>
      </>
    ) : (
      <>
        <p class="mb-6 text-xs uppercase tracking-[0.22em] text-sky">
          {hero.overline}
        </p>
        <h1 class="max-w-4xl text-[clamp(2.75rem,9vw,6rem)] text-chiffon">
          {hero.headline}
        </h1>
      </>
    )}

    <p class="mt-5 max-w-lg text-lg leading-relaxed text-chiffon/85">
      {hero.subhead}
    </p>

    <a
      href={hero.cta.href}
      class="mt-9 inline-flex w-fit items-center gap-3 border-b border-sky pb-1 text-sm uppercase tracking-[0.16em] text-chiffon transition-opacity hover:opacity-70"
    >
      {hero.cta.label}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>
