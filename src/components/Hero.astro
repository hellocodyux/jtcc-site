---
/**
 * Hero — a block of forest green with the name in script and three
 * short words underneath. Nothing else.
 */
import content from '~/content/content.json';
const { hero, business } = content;
const tagline: string[] = hero.tagline ?? [];
---
<section id="top" data-hero class="band-invert relative overflow-hidden">
  <div class="mx-auto flex max-w-6xl flex-col items-center px-6 pb-20 pt-32 text-center md:pb-28 md:pt-40">
    <h1 class="script text-chiffon text-[clamp(2.4rem,6.6vw,5rem)] leading-[1.15] md:whitespace-nowrap">
      {business.name}
    </h1>
    {tagline.length > 0 && (
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-chiffon/90 md:mt-8 md:gap-x-7">
        {tagline.map((t, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="dot h-1.5 w-1.5 rounded-full"></li>}
            <li class="text-[0.78rem] uppercase tracking-[0.22em] md:text-sm">{t}</li>
          </>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  /* A lighter ember so the dots read on the green */
  .dot { background-color: #E0714F; }
</style>
