---
/**
 * Nav — a quiet row of small caps. Transparent over the green hero
 * (cream type); cream with ink type once you scroll past it. The JTCC
 * mark on the left is always there and always goes home.
 */
import content from '~/content/content.json';
const { nav, business } = content;
interface Props { overHero?: boolean; }
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => href.startsWith('/') && !href.includes('#') && path === href;
const links = nav.filter((n) => !n.href.includes('#'));
---
<header
  class:list={[
    'fixed z-40 transition-colors duration-300',
    overHero ? 'text-chiffon' : 'bg-chiffon/95 text-coffee shadow-[0_1px_0_rgba(199,187,163,0.6)] backdrop-blur-sm',
  ]}
  data-nav
  data-over-hero={overHero ? 'true' : 'false'}
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4" aria-label="Primary">
    <a
      href="/"
      class="script text-xl transition-opacity duration-300 hover:opacity-70"
      aria-label={`${business.name} home`}
      data-nav-mark
    >
      {business.shortName}
    </a>
    <ul class="flex items-center gap-5 md:gap-8">
      {links.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={['text-[0.72rem] uppercase tracking-[0.18em] transition-opacity hover:opacity-65', isCurrent(item.href) && 'opacity-70']}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="hidden sm:block">
        <a href="/#contact" class="nav-pill">Get in touch</a>
      </li>
      <li class="flex items-center">
        <a
          href={business.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Joshua Tree Catering Co. on Instagram, @${business.instagram}`}
          class="block transition-opacity hover:opacity-65"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-[1.1rem] w-[1.1rem]" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5.2" stroke="currentColor" stroke-width="1.8" />
            <circle cx="12" cy="12" r="4.1" stroke="currentColor" stroke-width="1.8" />
            <circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" />
          </svg>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  if (nav instanceof HTMLElement && nav.dataset.overHero === 'true') {
    const hero = document.querySelector('[data-hero]');
    const onScroll = () => {
      const limit = hero ? hero.getBoundingClientRect().height - 70 : 300;
      const past = window.scrollY > limit;
      nav.classList.toggle('bg-chiffon/95', past);
      nav.classList.toggle('backdrop-blur-sm', past);
      nav.classList.toggle('text-coffee', past);
      nav.classList.toggle('text-chiffon', !past);
      nav.classList.toggle('shadow-[0_1px_0_rgba(199,187,163,0.6)]', past);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  /* Get in touch sits in a rounded outline, so it reads as the one
     thing to click. Inherits the nav's colour in both states. */
  .nav-pill {
    display: inline-block;
    padding: 0.42rem 0.95rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    line-height: 1;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  /* Over the green header: fills cream */
  [data-nav].text-chiffon .nav-pill:hover {
    background-color: var(--color-chiffon);
    color: var(--color-forest);
  }
  /* Once scrolled onto cream: fills green */
  [data-nav].text-coffee .nav-pill {
    border-color: var(--color-ember);
    color: var(--color-ember);
  }
  [data-nav].text-coffee .nav-pill:hover {
    background-color: var(--color-ember);
    color: var(--color-chiffon);
  }
</style>
