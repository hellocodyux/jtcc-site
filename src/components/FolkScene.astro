---
/**
 * FolkScene — a large paper-cut tableau: the long table.
 *
 * A footed bowl heaped with fruit, a pitcher, a loaf, two cups; the
 * desert sun rising over a Joshua tree; boulders and a wave of ground
 * beneath. Flat silhouettes in a single colour (currentColor), meant to
 * sit faded behind a section as a big, quiet backdrop.
 *
 * Decorative only — always aria-hidden.
 */
interface Props { class?: string; }
const { class: className = '' } = Astro.props;

// Sun rays — tapered wedges at uneven lengths.
const rays = [30, 24, 28, 22, 31, 25, 27, 23, 30, 24, 28, 22, 31, 25, 27, 23, 29, 24];

// Joshua tree rosettes: many short spikes around each arm tip.
const rosettes = [
  { x: 458, y: 264, n: 22, len: 36 },
  { x: 552, y: 250, n: 22, len: 36 },
  { x: 508, y: 206, n: 24, len: 40 },
];
const spikes = (n: number) => Array.from({ length: n }, (_, i) => i);

// Fruit heap in the bowl.
const fruit = [
  [287, 404, 17], [325, 398, 18], [363, 404, 17],
  [306, 380, 15], [344, 380, 15], [325, 360, 14],
];

// Tablecloth scallops along the table's underside.
const cloth = Array.from({ length: 10 }, (_, i) => 110 + i * 41.5);

// Sparkles in the sky.
const sparkles = [
  [64, 58, 9], [292, 74, 7], [596, 128, 8], [418, 46, 6], [230, 150, 5],
];
---
<svg
  viewBox="0 0 640 640"
  class={className}
  fill="currentColor"
  aria-hidden="true"
>
  <!-- Sun -->
  <g transform="translate(150 122)">
    <circle r="42" />
    {rays.map((len, i) => {
      const a = (i * 360) / rays.length;
      return (
        <path
          d={`M-4 -50 L0 ${-50 - len} L4 -50 Z`}
          transform={`rotate(${a})`}
        />
      );
    })}
  </g>

  <!-- Sparkles -->
  {sparkles.map(([x, y, s]) => (
    <path
      d={`M${x} ${y - s} C ${x + s * 0.18} ${y - s * 0.18}, ${x + s * 0.18} ${y - s * 0.18}, ${x + s} ${y}
          C ${x + s * 0.18} ${y + s * 0.18}, ${x + s * 0.18} ${y + s * 0.18}, ${x} ${y + s}
          C ${x - s * 0.18} ${y + s * 0.18}, ${x - s * 0.18} ${y + s * 0.18}, ${x - s} ${y}
          C ${x - s * 0.18} ${y - s * 0.18}, ${x - s * 0.18} ${y - s * 0.18}, ${x} ${y - s} Z`}
    />
  ))}

  <!-- Joshua tree -->
  <g>
    {/* trunk */}
    <path d="M478 584 C 486 500, 490 400, 494 300 L 522 300 C 526 400, 532 500, 544 584 Z" />
    {/* left arm */}
    <path d="M494 330 C 482 308, 472 292, 460 272 L 476 262 C 488 280, 498 296, 508 314 Z" />
    {/* right arm */}
    <path d="M510 316 C 524 296, 536 276, 546 254 L 562 262 C 550 282, 538 300, 524 326 Z" />
    {/* top arm */}
    <path d="M498 304 L 500 214 L 516 214 L 520 304 Z" />
    {/* shaggy bark tufts */}
    <path d="M490 360 L 476 376 L 496 370 Z M526 384 L 542 400 L 522 392 Z M486 430 L 470 448 L 492 440 Z M532 452 L 550 468 L 528 462 Z M484 500 L 468 518 L 490 510 Z M536 520 L 554 536 L 532 530 Z" />
    {/* rosettes */}
    {rosettes.map((r) => (
      <g transform={`translate(${r.x} ${r.y})`}>
        <circle r="9" />
        {spikes(r.n).map((i) => {
          const a = (i * 360) / r.n + (i % 2) * 4;
          const len = r.len * (i % 3 === 0 ? 1 : i % 3 === 1 ? 0.82 : 0.92);
          return <path d={`M-2.4 0 L0 ${-len} L2.4 0 Z`} transform={`rotate(${a})`} />;
        })}
      </g>
    ))}
  </g>

  <!-- Boulders behind the table -->
  <path d="M40 585 C 60 540, 120 536, 150 566 C 170 546, 210 550, 220 585 Z" />
  <path d="M556 585 C 570 556, 608 552, 636 582 L 636 585 Z" />

  <!-- Table -->
  <rect x="88" y="460" width="412" height="16" rx="6" />
  <g>
    {cloth.map((x) => (
      <path d={`M${x - 20} 476 A20 20 0 0 0 ${x + 20} 476 Z`} />
    ))}
  </g>
  {/* legs */}
  <path d="M124 476 L 118 566 L 142 566 L 146 476 Z" />
  <path d="M444 476 L 448 566 L 472 566 L 466 476 Z" />

  <!-- Footed bowl with fruit -->
  <g>
    <path d="M256 418 L 394 418 C 392 446, 364 462, 325 462 C 286 462, 258 446, 256 418 Z" />
    <rect x="316" y="460" width="18" height="10" />
    <path d="M300 470 L 350 470 L 342 460 L 308 460 Z" />
    {fruit.map(([x, y, r]) => (
      <>
        <circle cx={x} cy={y} r={r} />
        <path d={`M${x} ${y - r} c 1 -6, 4 -8, 8 -9`} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </>
    ))}
    {/* leaves tucked among the fruit */}
    <path d="M272 388 C 262 376, 250 372, 238 374 C 246 386, 258 392, 272 388 Z" />
    <path d="M378 388 C 388 376, 400 372, 412 374 C 404 386, 392 392, 378 388 Z" />
  </g>

  <!-- Pitcher -->
  <g>
    <path d="M172 372 L 206 372 L 200 384 C 214 400, 216 428, 208 460 L 172 460 C 164 430, 166 400, 178 384 Z" />
    <path d="M166 376 L 156 368 L 176 366 Z" />
    <path d="M206 396 C 226 396, 232 428, 210 444 L 210 434 C 222 426, 220 406, 206 406 Z" />
  </g>

  <!-- Loaf -->
  <path d="M408 460 C 404 434, 422 420, 450 420 C 478 420, 496 434, 492 460 Z" />
  <path d="M430 428 L 436 438 M450 424 L 454 435 M470 428 L 464 438" fill="none" stroke="var(--color-chiffon-deep)" stroke-width="2.4" stroke-linecap="round" />

  <!-- Cups -->
  <path d="M226 428 L 254 428 L 250 460 L 230 460 Z" />
  <path d="M262 436 L 284 436 L 281 460 L 265 460 Z" />

  <!-- Ground wave -->
  <path
    d="M20 600 c 26 -14, 52 -14, 78 0 s 52 14, 78 0 52 -14, 78 0 52 14, 78 0 52 -14, 78 0 52 14, 78 0 52 -14, 78 0"
    fill="none"
    stroke="currentColor"
    stroke-width="4"
    stroke-linecap="round"
  />
</svg>
