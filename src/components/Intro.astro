---
/**
 * Intro — heading layered over the photo, body copy beside it,
 * folk motifs filling the space below.
 */
import content from '~/content/content.json';
import Figure from './Figure.astro';
import Ornament from './Ornament.astro';
const { intro } = content;
---
<section class="band relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 pb-14 pt-16 md:pb-20 md:pt-20">
    <div class="grid items-start gap-x-12 gap-y-8 md:grid-cols-12">

      <div class="reveal relative md:col-span-5 md:col-start-1 md:row-start-1">
        <div class="warm rounded-photo relative mx-auto max-w-[26rem] overflow-hidden shadow-[0_14px_38px_rgba(45,18,13,0.16)] md:mx-0">
          <Figure
            image={intro.image}
            class="aspect-[4/3] w-full object-cover md:aspect-[4/5]"
            sizes="(min-width: 768px) 40vw, 90vw"
          />
          <div
            class="pointer-events-none absolute inset-x-0 top-0 h-[46%]"
            style="background: linear-gradient(to bottom, rgba(255,248,202,0.78), rgba(255,248,202,0.28) 55%, rgba(255,248,202,0) 100%);"
            aria-hidden="true"
          ></div>
        </div>
      </div>

      <h2 class="reveal relative z-10 text-[clamp(2.5rem,7vw,4.5rem)] leading-[0.98] md:col-span-6 md:col-start-1 md:row-start-1 md:mt-8 md:pl-8">
        {intro.heading}
      </h2>

      <div class="reveal md:col-span-6 md:col-start-7 md:row-start-1 md:pt-8">
        <div class="space-y-5 text-lg leading-relaxed">
          {intro.body.map((p) => <p>{p}</p>)}
        </div>

        <!-- Fills the space the copy leaves behind -->
        <div class="mt-10 flex items-end gap-7 text-rosewood/45" aria-hidden="true">
          <Ornament motif="sun" class="h-14 w-14 shrink-0" />
          <Ornament motif="sprig" class="h-16 w-10 shrink-0" />
          <Ornament motif="vessel" class="h-16 w-12 shrink-0" />
          <Ornament motif="bloom" class="h-12 w-12 shrink-0" />
        </div>
      </div>

    </div>
  </div>
</section>
