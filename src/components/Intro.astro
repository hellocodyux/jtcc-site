---
/**
 * Intro — photo on the left, a centred column of copy on the right:
 * heading, a few short paragraphs, and an outlined button.
 */
import content from '~/content/content.json';
import Figure from './Figure.astro';
const { intro } = content;
---
<section class="band relative">
  <div class="mx-auto max-w-6xl px-6 pb-20 pt-16 md:pb-28 md:pt-20">
    <div class="grid items-center gap-x-14 gap-y-10 md:grid-cols-12">

      <div class="reveal md:col-span-6">
        <div class="dot-frame mx-auto max-w-[26rem] md:mx-0">
          <div class="warm">
            <Figure
              image={intro.image}
              class="aspect-[4/5] w-full object-cover"
              sizes="(min-width: 768px) 40vw, 90vw"
            />
          </div>
        </div>
      </div>

      <div class="reveal text-center md:col-span-6 md:px-4">
        <h2 class="text-rosewood text-[clamp(2.5rem,5.5vw,4rem)] leading-[0.98]">
          {intro.heading}
        </h2>
        <div class="mx-auto mt-8 max-w-md space-y-4 text-[0.95rem] leading-relaxed text-coffee/85 md:text-base">
          {intro.body.map((p) => <p>{p}</p>)}
        </div>
        {intro.cta && (
          <a href={intro.cta.href} class="btn-outline mt-9">
            {intro.cta.label}
          </a>
        )}
      </div>

    </div>
  </div>
</section>
