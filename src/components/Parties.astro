---
import content from '~/content/content.json';
import SectionHead from './SectionHead.astro';
const { parties } = content;
---
<section id="parties" class="border-t border-clay/30">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-36">
    <SectionHead heading={parties.heading} intro={parties.intro} />

    <dl class="grid gap-x-12 gap-y-12 md:grid-cols-2">
      {parties.services.map((service) => (
        <div class="reveal border-t border-clay/40 pt-6">
          <dt class="font-display text-2xl md:text-3xl">{service.name}</dt>
          <dd class="mt-3 max-w-sm text-base leading-relaxed text-ink/75">
            {service.description}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
