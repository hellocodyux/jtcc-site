---
import content from '~/content/content.json';
import SectionHead from './SectionHead.astro';
const { parties } = content;
---
<section id="parties" class="border-t border-clay/30">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-36">
    <SectionHead heading={parties.heading} intro={parties.intro} />

    <dl class="grid gap-x-16 gap-y-14 md:grid-cols-2">
      {parties.services.map((service) => (
        <div class="reveal border-t border-clay/40 pt-6">
          <dt class="flex flex-wrap items-baseline justify-between gap-x-4">
            <span class="font-display text-2xl md:text-3xl">{service.name}</span>
            <span class="tabular text-base text-ember">{service.price}</span>
          </dt>
          <dd class="mt-3 text-base leading-relaxed text-ink/75">
            {service.description}

            {service.terms.length > 0 && (
              <ul class="mt-4 space-y-1 text-sm text-ink/55">
                {service.terms.map((t) => (
                  <li class="flex gap-2">
                    <span class="text-clay" aria-hidden="true">&mdash;</span>
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>

    <div class="reveal mt-20 border-t border-clay/40 pt-8 md:flex md:gap-16">
      <h3
        class="font-body text-xs uppercase tracking-[0.28em] text-ember md:w-1/3"
      >
        {parties.ordering.heading}
      </h3>
      <ul class="mt-6 max-w-xl space-y-3 text-base leading-relaxed text-ink/70 md:mt-0">
        {parties.ordering.notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
