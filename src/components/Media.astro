---
import content from '~/content/content.json';
import SectionHead from './SectionHead.astro';
import Figure from './Figure.astro';
const { media } = content;
---
<section id="media" class="border-t border-clay/30 bg-bone">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-36">
    <SectionHead heading={media.heading} intro={media.intro} />

    <!-- Deliberately uneven so it reads as a spread, not a product grid -->
    <div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
      {media.gallery.map((img, i) => {
        const span = [
          'md:col-span-4', 'md:col-span-2', 'md:col-span-2',
          'md:col-span-2', 'md:col-span-2', 'md:col-span-6',
        ][i % 6];
        const ratio = i % 6 === 5 ? 'aspect-[21/9]' : 'aspect-[4/5] md:aspect-[4/3]';
        return (
          <figure class={`reveal ${span} overflow-hidden`}>
            <Figure
              image={img}
              class={`${ratio} w-full object-cover transition-transform duration-700 hover:scale-[1.03]`}
              sizes="(min-width: 900px) 50vw, 100vw"
            />
          </figure>
        );
      })}
    </div>
  </div>
</section>
