---
import content from '~/content/content.json';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import PageHeader from '~/components/PageHeader.astro';
import ContactForm from '~/components/ContactForm.astro';
import Footer from '~/components/Footer.astro';
const { services, business } = content;
---
<Base
  title={`Services | ${business.name}`}
  description="Private chef, event catering, production catering, meal prepping, and retreat meals in Joshua Tree and the high desert."
>
  <Nav />
  <main id="main">
    <PageHeader heading={services.heading} lede={services.intro} />

    <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <dl class="grid gap-x-12 gap-y-14 md:grid-cols-2">
        {services.items.map((service) => (
          <div class="reveal border-t border-sand pt-6">
            <dt class="font-display text-2xl md:text-3xl">{service.name}</dt>
            <dd class="mt-3 max-w-sm text-base leading-relaxed text-coffee/75">
              {service.description}
            </dd>
          </div>
        ))}
      </dl>

      <p class="reveal mt-16 max-w-xl border-l-2 border-rosewood pl-5 text-base leading-relaxed text-coffee/75">
        {services.pricingNote}
      </p>
    </section>

    <ContactForm />
  </main>
  <Footer />
  </main>
</Base>
